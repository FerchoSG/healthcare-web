{
  "version": "1.0.0",
  "name": "CitaBox · Clínica clara",
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "control": 6, "panel": 10, "dialog": 12 },
  "typeSize": { "metadata": 12, "body": 14, "mobileInput": 16, "section": 18, "page": 24 },
  "controlHeight": { "desktop": 40, "touch": 44 },
  "colors": {
    "light": {
      "canvas": "#F5F7F6", "surface": "#FFFFFF", "surface-alt": "#ECF2F0",
      "text": "#1F2D2A", "text-muted": "#55655F", "border": "#D6E0DB", "control-border": "#778A82",
      "action": "#175C66", "action-hover": "#104A53", "on-action": "#FFFFFF", "action-soft": "#E8F3F3",
      "info": "#245C86", "info-bg": "#EDF4FA",
      "success": "#236548", "success-bg": "#EAF4EE",
      "warning": "#885B12", "warning-bg": "#FFF4DB",
      "danger": "#A52B36", "danger-bg": "#FBECEF",
      "focus": "#245C86", "neutral": "#55655F", "neutral-bg": "#ECF0EE"
    },
    "dark": {
      "canvas": "#111B18", "surface": "#192823", "surface-alt": "#20332C",
      "text": "#EAF2EE", "text-muted": "#B4C5BC", "border": "#334A40", "control-border": "#7F998B",
      "action": "#8BCED1", "action-hover": "#AFDEE0", "on-action": "#102525", "action-soft": "#213C38",
      "info": "#9FC6E5", "info-bg": "#233342",
      "success": "#93D4A9", "success-bg": "#21382C",
      "warning": "#EAC780", "warning-bg": "#3E3320",
      "danger": "#F2AAB3", "danger-bg": "#40282F",
      "focus": "#9FC6E5", "neutral": "#B4C5BC", "neutral-bg": "#20332C"
    }
  },
  "appointmentStates": {
    "PENDING": { "label": "Pendiente de confirmar", "tone": "neutral" },
    "CONFIRMED": { "label": "Confirmada", "tone": "info" },
    "WAITING": { "label": "En espera", "tone": "warning" },
    "IN_CONSULTATION": { "label": "En consulta", "tone": "action" },
    "COMPLETED": { "label": "Completada", "tone": "success" },
    "CANCELLED": { "label": "Cancelada", "tone": "danger" }
  },
  "contrastPairs": [
    { "foreground": "text", "background": "surface", "minimum": 4.5 },
    { "foreground": "text", "background": "canvas", "minimum": 4.5 },
    { "foreground": "text", "background": "surface-alt", "minimum": 4.5 },
    { "foreground": "text-muted", "background": "surface", "minimum": 4.5 },
    { "foreground": "text-muted", "background": "canvas", "minimum": 4.5 },
    { "foreground": "text-muted", "background": "surface-alt", "minimum": 4.5 },
    { "foreground": "on-action", "background": "action", "minimum": 4.5 },
    { "foreground": "on-action", "background": "action-hover", "minimum": 4.5 },
    { "foreground": "action", "background": "action-soft", "minimum": 4.5 },
    { "foreground": "action", "background": "surface", "minimum": 4.5 },
    { "foreground": "info", "background": "info-bg", "minimum": 4.5 },
    { "foreground": "success", "background": "success-bg", "minimum": 4.5 },
    { "foreground": "warning", "background": "warning-bg", "minimum": 4.5 },
    { "foreground": "danger", "background": "danger-bg", "minimum": 4.5 },
    { "foreground": "neutral", "background": "neutral-bg", "minimum": 4.5 },
    { "foreground": "focus", "background": "surface", "minimum": 3 },
    { "foreground": "focus", "background": "canvas", "minimum": 3 },
    { "foreground": "control-border", "background": "surface", "minimum": 3 },
    { "foreground": "control-border", "background": "surface-alt", "minimum": 3 }
  ]
}
